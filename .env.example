# ---- Database ---------------------------------------------------------------
# Uncomment to use PostgreSQL (also set in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://gramarogya:gramarogya@localhost:5432/gramarogya
# If DATABASE_URL is NOT set, the app falls back to a local SQLite file
# (backend/gramarogya.db) so `uvicorn` works with zero setup.

# ---- SMS provider -----------------------------------------------------------
# mock   = logs "SMS sent to +91..." to the console and marks messages sent (default)
# twilio = real delivery via Twilio (swap-in ready)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- CORS --------------------------------------------------------------------
CORS_ORIGINS=*

# ---- Frontend ----------------------------------------------------------------
# Directory that holds the three web apps: asha-worker/ doctor-portal/ admin-dashboard/
# FRONTEND_DIR=../frontend